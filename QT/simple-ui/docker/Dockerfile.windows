# syntax=docker/dockerfile:1
FROM stateoftheartio/qt6:6.7-mingw-aqt

WORKDIR /src

# Cross-compiles simple-ui.exe using MinGW Qt 6, then runs windeployqt via wine to bundle DLLs
CMD ["sh", "-c", "mkdir -p /tmp/build && cd /tmp/build && qt-cmake /src -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build . && mkdir -p /output && cp simple-ui.exe /output/ && (cd /output && wine windeployqt --qmldir /src /output/simple-ui.exe 2>/dev/null || true) && echo '>>> [SUCCESS] Windows package generated at /output/'"]
